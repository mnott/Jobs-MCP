{
  "name": "jobs-mcp",
  "version": "0.1.0",
  "description": "MCP server for job-search workflows — scraping, liveness, link unwrap, triage — writes to SeriousLetter via its external API.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jobs-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "job-search",
    "scraping",
    "ats",
    "career"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mnott/jobs-mcp.git"
  },
  "author": "Matthias Nott",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "bun run src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
